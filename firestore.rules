
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Allow users to read their own profile and for admins to read all profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
    
    match /user_notifications/{userId}/{document=**} {
      allow read, write, delete: if request.auth.uid == userId;
    }

    match /students_cgpa/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /student_grades/{userId} {
        allow read, write: if request.auth.uid == userId;
    }
    
    match /faculty/{docId} {
      allow read: if request.auth != null;
    }
    
    match /faculty-requests/{docId} {
      allow create: if request.auth != null;
    }
    
    match /concept-maps/{docId} {
      allow read: if request.auth != null;
    }

    match /pdf-knowledge-cache/{docId} {
        allow read: if request.auth != null;
        // Allow writes only from server-side admin code for caching
        allow write: if false; 
    }
    
    match /contact-messages/{docId} {
        allow create: if request.auth != null;
    }

    match /login-issues/{docId} {
        allow create: if true; // Allow anyone to report a login issue
    }
    
    match /events/{docId} {
        allow read: if request.auth != null;
    }
    
    match /certifications/{docId} {
        allow read: if request.auth != null;
    }

    match /updates/{docId} {
        allow read: if request.auth != null;
    }
    
    match /course-suggestions/{docId} {
        allow create: if request.auth != null;
    }

    match /projects/{docId} {
        allow read: if request.auth != null;
    }

    match /recruitment-submissions/{docId} {
      allow create: if request.auth != null;
    }
  }
}
