rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    // Helper Functions
    // =================================
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'madiremohanreddy0400.sse@saveetha.com';
    }

    function isBatchAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/batchAdmins/$(request.auth.uid));
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // =================================
    // Admin & Role-Specific Collections
    // =================================
    match /batchAdmins/{userId} {
        allow read, write, delete: if isAdmin();
    }
    
    match /contact-messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /login-issues/{issueId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /faculty-requests/{requestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
    
    match /course-suggestions/{suggestionId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
    
    match /counter/{docId} {
        allow read, write: if false; // Only admin SDK
    }
    
    match /recruitment-submissions/{docId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }


    // =================================
    // User-Specific Data
    // =================================
    match /users/{userId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if isOwner(userId);
    }
    match /users/{userId}/fcmTokens/{tokenId} {
      allow all: if isOwner(userId);
    }
    match /students_cgpa/{userId} {
      allow all: if isOwner(userId);
    }
    match /student_grades/{userId} {
      allow all: if isOwner(userId);
    }
    match /user_notifications/{userId}/{document=**} {
      allow all: if isOwner(userId);
    }

    // =================================
    // Public & Authenticated Collections
    // =================================

    // Collections anyone can read
    match /faculty/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /updates/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /events/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Collections requiring authentication to read
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    match /certifications/{docId} {
      allow read: if request.auth != null;
      allow create: if isBatchAdmin() || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /concept-maps/{docId} {
      allow read: if request.auth != null;
      allow create: if isBatchAdmin() || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /concept-map-analytics/{mapId} {
      allow read: if true;
      allow write: if false; // Server-side only
    }
     match /link-drop-sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }
     match /enrollments/{enrollmentId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // =================================
    // Nested College Data (Public Read)
    // =================================
    match /colleges/{collegeId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
    }
    match /colleges/{collegeId}/departments/{departmentId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
    }
     match /colleges/{collegeId}/departments/{departmentId}/courses/{courseId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
    }
    
    // =================================
    // Nested Course Content
    // =================================
     match /course-content/{courseId}/{document=**} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
     }
     match /mcqs/{courseId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
     }
     match /coding-questions/{questionId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
     }
  }
}