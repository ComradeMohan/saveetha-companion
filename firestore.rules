rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the main admin.
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'madiremohanreddy0400.sse@saveetha.com';
    }

    // Helper function to check if the user is a batch admin.
    function isBatchAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/batchAdmins/$(request.auth.uid));
    }

    // Collection to store batch admin user IDs
    match /batchAdmins/{userId} {
        allow read, write, delete: if isAdmin();
    }

    // Allow public read/write for the Link Drop feature
    match /link-drop-sessions/{sessionId} {
      allow read, write: if true;
    }

    match /concept-map-analytics/{mapId} {
      allow read: if request.auth != null;
      allow write: if false; // All writes must go through the trusted server action
    }
    
    // Allow authenticated users to manage their own data.
    match /users/{userId} {
      allow create: if request.auth != null;
      // Admins and Batch Admins can read user profiles for management purposes.
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin() || isBatchAdmin();
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /students_cgpa/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /student_grades/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /user_notifications/{userId}/{document=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /recruitment-submissions/{docId} {
      allow create: if request.auth != null;
    }

    // Public read for most collections for any authenticated user.
    match /faculty/{docId} {
      allow read: if request.auth != null;
    }
    match /updates/{docId} {
      allow read: if request.auth != null;
    }
    match /events/{docId} {
      allow read: if request.auth != null;
    }
    match /projects/{projectId} {
      allow read: if request.auth != null;
    }
    match /colleges/{collegeId} {
        allow read: if request.auth != null;
    }
    match /colleges/{collegeId}/departments/{departmentId} {
        allow read: if request.auth != null;
    }
    match /colleges/{collegeId}/departments/{departmentId}/courses/{courseId} {
        allow read: if request.auth != null;
    }

    // Allow Batch Admins to create, but only main admin to manage.
    match /certifications/{docId} {
      allow read: if request.auth != null;
      allow create: if isBatchAdmin() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /concept-maps/{docId} {
      allow read: if request.auth != null;
      allow create: if isBatchAdmin() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Allow form submissions for authenticated users.
    match /contact-messages/{messageId} {
      allow create: if request.auth != null;
    }
    match /login-issues/{issueId} {
      allow create: if true; // Allow unauthenticated for login issues
    }
    match /enrollments/{enrollmentId} {
      allow create: if request.auth != null;
    }
    match /faculty-requests/{requestId} {
      allow create: if request.auth != null;
    }
    match /course-suggestions/{suggestionId} {
        allow create: if request.auth != null;
    }

    // Block client-side access to analytics counter.
    match /counter/{docId} {
        allow read, write: if false;
    }

    // Admin catch-all for any other path.
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
