
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the main admin.
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'madiremohanreddy0400.sse@saveetha.com';
    }

    // Helper function to check if the user is a batch admin.
    function isBatchAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/batchAdmins/$(request.auth.uid));
    }

    // Collection to store batch admin user IDs
    match /batchAdmins/{userId} {
        // Main admin can manage all documents.
        // A user can read their own batch admin document to verify their status.
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow write, delete: if isAdmin();

        // Allow batch admins to create activity logs for themselves.
        match /activity/{activityId} {
          allow create: if request.auth != null && request.auth.uid == userId;
          allow read, delete: if isAdmin();
        }
    }

    // Allow public read/write for the Link Drop feature
    match /link-drop-sessions/{sessionId} {
      allow read, write: if true;
    }

    match /concept-map-analytics/{mapId} {
      allow read: if true;
      allow write: if false; // All writes must go through the trusted server action
    }
    
    // Allow authenticated users to manage their own data first.
    match /users/{userId} {
      allow create: if request.auth != null;
      // User can read their own profile, Admin can read any profile.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
     match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /students_cgpa/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /student_grades/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /user_notifications/{userId}/{document=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // PUBLIC COLLECTIONS
    match /faculty/{docId} { allow read: if true; }
    match /updates/{docId} { allow read: if true; }
    match /events/{docId} { allow read: if true; }
    match /projects/{projectId} { allow read: if true; }
    match /colleges/{collegeId} { allow read: if true; }
    match /colleges/{collegeId}/departments/{departmentId} { allow read: if true; }
    match /colleges/{collegeId}/departments/{departmentId}/courses/{courseId} { allow read: if true; }
    match /mcqs/{docId} { allow read: if true; }
    match /coding-questions/{docId} { allow read: if true; }

    // AUTHENTICATED READ
    match /certifications/{docId} { allow read: if request.auth != null; }
    match /concept-maps/{docId} { allow read: if request.auth != null; }

    // AUTHENTICATED/ADMIN WRITE
    match /certifications/{docId} {
        allow create: if isBatchAdmin() || isAdmin();
        allow update, delete: if isAdmin();
    }
    match /concept-maps/{docId} {
        allow create: if isBatchAdmin() || isAdmin();
        allow update, delete: if isAdmin();
    }
    
    // FORM SUBMISSIONS
    match /contact-messages/{messageId} { allow create: if true; }
    match /login-issues/{issueId} { allow create: if true; }
    match /enrollments/{enrollmentId} { allow create: if request.auth != null; }
    match /faculty-requests/{requestId} { allow create: if request.auth != null; }
    match /course-suggestions/{suggestionId} { allow create: if request.auth != null; }
    match /recruitment-submissions/{docId} { allow create: if request.auth != null; }

    // This rule is for clarity. The server-side code uses Admin access,
    // which bypasses these rules, but it's good practice to define access.
    // This rule effectively blocks any direct client-side access.
    match /counter/{docId} {
        allow read, write: if false;
    }

    // This rule is a final catch-all and should not be relied upon for general access.
    // It primarily grants admins write access to collections not explicitly defined above.
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
