
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin.
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'madiremohanreddy0400.sse@saveetha.com';
    }

    // Allow authenticated users to manage their own data first.
    match /users/{userId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /students_cgpa/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /student_grades/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow public read/write for the Link Drop feature
    match /link-drop-sessions/{sessionId} {
      allow read, write: if true;
    }
    
    // --- START: NEW RULE FOR CONCEPT MAP ANALYTICS ---
    // Allow anyone to read the analytics data.
    // Writes are handled by the server-side action, so client-side writes are disallowed.
    match /concept-map-analytics/{mapId} {
      allow read: if true;
      allow write: if false; // All writes must go through the trusted server action
    }
    // --- END: NEW RULE ---

    // Allow anyone to read public data collections.
    match /faculty/{docId} {
      allow read: if true;
    }
    match /concept-maps/{docId} {
      allow read: if true;
    }
    match /updates/{docId} {
      allow read: if true;
    }
    match /events/{docId} {
      allow read: if true;
    }
    match /projects/{projectId} {
      allow read: if true;
    }
    match /certifications/{docId} {
      allow read: if true;
    }
    match /colleges/{collegeId} {
        allow read: if true;
    }
    match /colleges/{collegeId}/departments/{departmentId} {
        allow read: if true;
    }
     match /colleges/{collegeId}/departments/{departmentId}/courses/{courseId} {
        allow read: if true;
    }
    match /mcqs/{courseId} {
        allow read: if request.auth != null;
    }

    // Allow anyone to submit forms (contact, issues, suggestions).
    match /contact-messages/{messageId} {
      allow create: if true;
    }
    match /login-issues/{issueId} {
      allow create: if true;
    }
    match /enrollments/{enrollmentId} {
      allow create: if request.auth != null;
    }
    match /faculty-requests/{requestId} {
      allow create: if request.auth != null;
    }
    match /course-suggestions/{suggestionId} {
      allow create: if request.auth != null;
    }


    // This rule is for clarity. The server-side code uses Admin access,
    // which bypasses these rules, but it's good practice to define access.
    // This rule effectively blocks any direct client-side access.
    match /counter/{docId} {
        allow read, write: if false;
    }

    // As a final catch-all, give admin full access to everything else.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
